{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/webhook.py": {
      "maxDuration": 300,
      "memory": 1024
    },
    "api/usta.py": {
      "maxDuration": 300,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/webhook?__web=/"
    },
    {
      "source": "/chat",
      "destination": "/api/webhook?__web=/chat"
    },
    {
      "source": "/api/query",
      "destination": "/api/webhook?__web=/api/query"
    },
    {
      "source": "/api/health",
      "destination": "/api/webhook?__web=/api/health"
    },
    {
      "source": "/api/stats",
      "destination": "/api/webhook?__web=/api/stats"
    }
  ]
}
