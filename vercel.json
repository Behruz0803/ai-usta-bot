{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/webhook.py": {
      "maxDuration": 300,
      "memory": 1024
    },
    "api/usta.py": {
      "maxDuration": 300,
      "memory": 1024
    },
    "api/index.py": {
      "maxDuration": 300,
      "memory": 1024
    },
    "api/query.py": {
      "maxDuration": 300,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "info"
        }
      ],
      "destination": "/api/webhook"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "setup"
        }
      ],
      "destination": "/api/webhook"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "db"
        }
      ],
      "destination": "/api/webhook"
    },
    {
      "source": "/",
      "destination": "/api/index"
    }
  ]
}
