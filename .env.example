# AI Usta bot — sozlamalar namunasi.
# Lokal ishga tushirish: shu faylni .env deb nusxalab, qiymatlarni kiriting.
# Vercel'da: Project → Settings → Environment Variables ga xuddi shu nomlar bilan kiriting.

# BotFather dan olingan Telegram bot tokeni (MAJBURIY).
# UZEX boti va ta'mir boti alohida token. Birini ikkinchisiga qo'ymang.
TELEGRAM_TOKEN=123456789:AA...tokeningiz...

# uzex = faqat birja. usta = faqat ta'mir. Bir jarayonda ikkalasi yoqilmaydi.
BOT_MODE=uzex
EXPECTED_BOT_USERNAME=uzexaihackaton_bot

# AI Usta alohida token va alohida manzil (/api/usta). UZEX tokeniga qo'ymang.
# USTA_TELEGRAM_TOKEN=123456789:AA...ai_usta_token...
# USTA_WEBHOOK_SECRET=boshqa_maxfiy_soz

# Gemini kalitlari alohida. Birini ikkinchi botga qo'ymang.
# UZEX_GEMINI_API_KEY=AQ....uzex...
# USTA_GEMINI_API_KEY=AQ....usta...
# GEMINI_API_KEY esa UZEX zaxira kaliti (USTA buni o'qimaydi)
GEMINI_API_KEY=AQ....uzex...

# Ixtiyoriy: Gemini modeli (bo'sh bo'lsa gemini-3-flash-preview)
# GEMINI_MODEL=gemini-3-flash-preview

# Ixtiyoriy: barcha murojaatlar tushadigan log-guruh ID'si (-100... bilan boshlanadi)
# AI Usta ham shu guruhga yozadi. Alohida guruh kerak bo'lsa USTA_LOG_CHAT_ID.
LOG_CHAT_ID=-1001234567890
# USTA_LOG_CHAT_ID=-1001234567890
# USTA_GEMINI_MODEL=gemini-3.5-flash-lite

# Ixtiyoriy (faqat webhook rejimi): webhook himoya tokeni.
# Telegram har so'rovda shu tokenni yuboradi, mos kelmasa so'rov rad etiladi.
WEBHOOK_SECRET=ozingiz_oylab_topgan_maxfiy_soz

# Ixtiyoriy (faqat webhook rejimi): botning doimiy manzili,
# masalan https://ai-usta-bot-mbm15.vercel.app
# Vercel'da bo'sh qoldirilsa avtomatik aniqlanadi.
# WEBHOOK_URL=https://ai-usta-bot-mbm15.vercel.app
